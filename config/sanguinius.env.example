# Required credentials. Prefer permission-restricted files to direct values.
SANGUINIUS_TOKEN_FILE=/path/to/bot.token
SANGUINIUS_OPENAI_API_KEY_FILE=/path/to/openai.key

# Required one-server boundary. Insert canonical decimal Discord IDs locally.
SANGUINIUS_GUILD_ID=
SANGUINIUS_PRIMARY_CHANNEL_ID=
SANGUINIUS_OWNER_USER_ID=

# Existing runtime settings.
SANGUINIUS_LOG_FILE=logs/messages.log
SANGUINIUS_COMMAND_PREFIX=!
SANGUINIUS_OPENAI_MODEL=gpt-5.6-luna
SANGUINIUS_PERSONA_FILE=config/persona.txt
SANGUINIUS_APPEARANCE_POLICY_FILE=config/appearance-policy-v2.json
SANGUINIUS_TAROT_DECK_FILE=config/emperor-tarot-v1.json
SANGUINIUS_TAROT_HOUSE_FILE=config/tarot-house-v1.json
SANGUINIUS_DISCORD_REQUEST_TIMEOUT_SECONDS=10
SANGUINIUS_TIMEZONE=America/New_York

# Persistent state. Initialize or upgrade it explicitly with `sanguinius db migrate`.
SANGUINIUS_DATABASE_FILE=state/sanguinius.sqlite3

# Owner slash commands and the transitional prefix health command are disabled
# by default. Test mode additionally gates the self-targeted immediate notice,
# 60-second scheduled notice, synthetic public retry controls, and owner-only
# balanced Tarot adjustment/reversal commands. Durable
# worker sizes, leases, attempts, polling, and backoff use conservative internal
# defaults; Milestone 5 adds no configuration variables for them.
SANGUINIUS_ADMIN_COMMANDS_ENABLED=false
SANGUINIUS_TEST_MODE=false

# Chronicle registers catalog-v12 commands for canon, explicit memory,
# sessions, approved summaries and titles, FTS recall, profiles, and
# anniversary controls. Appearance quiet/feedback, persisted Tarot draws,
# peer/House wagers, Vox speech controls, records, and owner controls share
# catalog v12. Its strict
# m13-tarot-1 appearance policy snapshot adds the `tarot_event` family. Modes are off,
# dry_run, and live; off remains the conservative default and dry_run cannot
# enqueue or send a public appearance.
SANGUINIUS_CHRONICLE_ENABLED=false
SANGUINIUS_TAROT_ENABLED=false

# Confirmed Fate economy defaults. Amounts must be 1..1,000,000,000;
# cooldowns must be 1..8,760 hours; Grace target must exceed its threshold;
# and the Trial reward bounds must be ordered. Tarot uses only immutable
# balanced ledger postings as authority. Schema v10 adds equal-stake, two-party
# wagers; schema v11 adds a versioned original deck and one-person House
# auguries with atomic escrow, a 100-Fate non-test exposure cap, and a 20-Fate
# per-wager profit cap. Fate has no real-money value. Asymmetric peer stakes,
# counteroffers, multi-party pools, purchases, and external gambling remain
# unsupported.
SANGUINIUS_TAROT_STARTING_FATE=100
SANGUINIUS_TAROT_GRACE_THRESHOLD=10
SANGUINIUS_TAROT_GRACE_TARGET=25
SANGUINIUS_TAROT_GRACE_COOLDOWN_HOURS=72
SANGUINIUS_TAROT_TRIAL_THRESHOLD=50
SANGUINIUS_TAROT_TRIAL_REWARD_MIN=5
SANGUINIUS_TAROT_TRIAL_REWARD_MAX=15
SANGUINIUS_TAROT_TRIAL_COOLDOWN_HOURS=24
SANGUINIUS_TAROT_WAGER_MINIMUM_STAKE=1
SANGUINIUS_TAROT_WAGER_MAXIMUM_STAKE=100
SANGUINIUS_TAROT_WAGER_OFFER_EXPIRY_HOURS=24
SANGUINIUS_TAROT_WAGER_DEFAULT_OUTCOME_HOURS=24
SANGUINIUS_TAROT_WAGER_RESOLUTION_GRACE_HOURS=48
SANGUINIUS_TAROT_DRAW_COOLDOWN_HOURS=24
SANGUINIUS_TAROT_HOUSE_ENABLED=true
SANGUINIUS_TAROT_HOUSE_EXPOSURE_CAP=100
SANGUINIUS_TAROT_HOUSE_PROFIT_CAP=20
SANGUINIUS_TAROT_INTEGRATION_ENABLED=true

SANGUINIUS_APPEARANCES_MODE=off
SANGUINIUS_VOX_ENABLED=false
SANGUINIUS_VOICE_INPUT_ENABLED=false

# Milestone 15 voice output. Limits may be lowered but never raised above the
# source-controlled ceilings. The fallback directory must contain an
# owner-approved, checksummed fallbacks-v1.json plus entrance/error/farewell PCM.
SANGUINIUS_TTS_PROVIDER=disabled
SANGUINIUS_TTS_MODEL=tts-1
SANGUINIUS_TTS_VOICE=onyx
SANGUINIUS_TTS_CACHE_DIRECTORY=/var/cache/sanguinius/tts
SANGUINIUS_FFMPEG_PATH=/usr/bin/ffmpeg
SANGUINIUS_FFPROBE_PATH=/usr/bin/ffprobe
SANGUINIUS_TTS_FALLBACK_DIRECTORY=/usr/local/share/sanguinius/vox
SANGUINIUS_TTS_MAXIMUM_TEXT_SCALARS=350
SANGUINIUS_TTS_ROLLING_DAY_ATTEMPTS=20
SANGUINIUS_TTS_ROLLING_DAY_MICRO_USD=100000
SANGUINIUS_TTS_MONTHLY_MICRO_USD=2000000
SANGUINIUS_TTS_CACHE_MAXIMUM_MIB=128
SANGUINIUS_TTS_CACHE_MAXIMUM_DAYS=30
SANGUINIUS_TTS_MAXIMUM_DURATION_SECONDS=20
SANGUINIUS_TTS_CONNECT_TIMEOUT_MS=5000
SANGUINIUS_TTS_REQUEST_TIMEOUT_MS=30000
SANGUINIUS_FFPROBE_TIMEOUT_MS=5000
SANGUINIUS_FFMPEG_TIMEOUT_MS=10000

# Required credentials. Prefer permission-restricted files to direct values.
SANGUINIUS_TOKEN_FILE=/path/to/bot.token
SANGUINIUS_OPENAI_API_KEY_FILE=/path/to/openai.key

# Required one-server boundary. Insert canonical decimal Discord IDs locally.
SANGUINIUS_GUILD_ID=
SANGUINIUS_PRIMARY_CHANNEL_ID=
SANGUINIUS_OWNER_USER_ID=

# Existing runtime settings.
SANGUINIUS_LOG_FILE=/var/log/sanguinius/messages.log
SANGUINIUS_COMMAND_PREFIX=!
SANGUINIUS_OPENAI_MODEL=gpt-5.6-luna
# Required audited text-model rates in integer micro-USD per million tokens.
# These gpt-5.6-luna standard short-context rates were verified against the
# official OpenAI pricing page on 2026-08-27 ($0.20 input / $1.20 output per
# million tokens). Changing the model, service tier, region, or context class
# requires a fresh audit. Set either rate to zero to fail closed; no prompt or
# response is stored in the budget ledger.
SANGUINIUS_OPENAI_INPUT_MICRO_USD_PER_MILLION_TOKENS=200000
SANGUINIUS_OPENAI_OUTPUT_MICRO_USD_PER_MILLION_TOKENS=1200000
SANGUINIUS_PERSONA_FILE=/opt/sanguinius/current/config/persona.txt
SANGUINIUS_APPEARANCE_POLICY_FILE=/opt/sanguinius/current/config/appearance-policy-v2.json
SANGUINIUS_TAROT_DECK_FILE=/opt/sanguinius/current/config/emperor-tarot-v1.json
SANGUINIUS_TAROT_HOUSE_FILE=/opt/sanguinius/current/config/tarot-house-v1.json
SANGUINIUS_DISCORD_REQUEST_TIMEOUT_SECONDS=10
SANGUINIUS_TIMEZONE=America/New_York

# Persistent state. Initialize or upgrade it explicitly with `sanguinius db migrate`.
SANGUINIUS_DATABASE_FILE=/var/lib/sanguinius/sanguinius.sqlite3
SANGUINIUS_OPERATIONS_STATUS_FILE=/var/lib/sanguinius/runtime/operations-status.json
SANGUINIUS_BACKUP_DIRECTORY=/var/backups/sanguinius

# Owner slash commands and the transitional prefix health command are disabled
# by default. Test mode additionally gates the self-targeted immediate notice,
# 60-second scheduled notice, synthetic public retry controls, and owner-only
# balanced Tarot adjustment/reversal commands. Unified `/sang-admin safety`
# controls remain owner-only and registered even with this flag false. Durable
# workers, orchestration scans, leases, attempts, polling, and backoff use
# conservative internal defaults.
SANGUINIUS_ADMIN_COMMANDS_ENABLED=false
SANGUINIUS_TEST_MODE=false

# Catalog v16 registers root `/help` and `/repo` plus Chronicle commands for
# canon, explicit memory, sessions, approved summaries and titles, FTS recall,
# profiles, and anniversary controls. Appearance quiet/feedback, persisted
# Tarot draws, peer/House wagers, Vox speech controls, records, and owner
# controls share that catalog. The current strict appearance policy adds the
# `tarot_event` family. Its serialized version remains compatibility data.
# Modes are off,
# dry_run, and live; off remains the conservative default and dry_run cannot
# enqueue or send a public appearance.
SANGUINIUS_CHRONICLE_ENABLED=false
SANGUINIUS_TAROT_ENABLED=false

# Confirmed Fate economy defaults. Amounts must be 1..1,000,000,000;
# cooldowns must be 1..8,760 hours; Grace target must exceed its threshold;
# and the Trial reward bounds must be ordered. Tarot uses only immutable
# balanced ledger postings as authority. Schema v10 adds equal-stake, two-party
# wagers; schema v11 adds a versioned original deck and one-person House
# auguries with atomic escrow, a 100-Fate non-test exposure cap, and a 20-Fate
# per-wager profit cap. Fate has no real-money value. Asymmetric peer stakes,
# counteroffers, multi-party pools, purchases, and external gambling remain
# unsupported.
SANGUINIUS_TAROT_STARTING_FATE=100
SANGUINIUS_TAROT_GRACE_THRESHOLD=10
SANGUINIUS_TAROT_GRACE_TARGET=25
SANGUINIUS_TAROT_GRACE_COOLDOWN_HOURS=72
SANGUINIUS_TAROT_TRIAL_THRESHOLD=50
SANGUINIUS_TAROT_TRIAL_REWARD_MIN=5
SANGUINIUS_TAROT_TRIAL_REWARD_MAX=15
SANGUINIUS_TAROT_TRIAL_COOLDOWN_HOURS=24
SANGUINIUS_TAROT_WAGER_MINIMUM_STAKE=1
SANGUINIUS_TAROT_WAGER_MAXIMUM_STAKE=100
SANGUINIUS_TAROT_WAGER_OFFER_EXPIRY_HOURS=24
SANGUINIUS_TAROT_WAGER_DEFAULT_OUTCOME_HOURS=24
SANGUINIUS_TAROT_WAGER_RESOLUTION_GRACE_HOURS=48
SANGUINIUS_TAROT_DRAW_COOLDOWN_HOURS=24
SANGUINIUS_TAROT_HOUSE_ENABLED=true
SANGUINIUS_TAROT_HOUSE_EXPOSURE_CAP=100
SANGUINIUS_TAROT_HOUSE_PROFIT_CAP=20
SANGUINIUS_TAROT_INTEGRATION_ENABLED=true

SANGUINIUS_APPEARANCES_MODE=off
SANGUINIUS_VOX_ENABLED=false
# Automatic Chronicle, Tarot, appearance, and contextual session-boundary
# narration. Requires Vox output. False advances new observations as suppressed
# so re-enabling cannot replay a backlog; direct /vox say remains independent.
SANGUINIUS_VOX_NARRATION_ENABLED=false

# Optional voice input. All required values are explicit and ship disabled.
# Consent is the owner's attestation that every present and joining
# human already consented outside Discord. The only supported model is
# gpt-transcribe; no other model is substituted. Limits may be lowered only.
# Raw received PCM is never persisted.
SANGUINIUS_VOICE_INPUT_ENABLED=false
SANGUINIUS_VOICE_INPUT_GUILD_CONSENT_ATTESTED=false
SANGUINIUS_TRANSCRIPTION_PROVIDER=disabled
SANGUINIUS_TRANSCRIPTION_MODEL=gpt-transcribe
SANGUINIUS_TRANSCRIPTION_REQUEST_TIMEOUT_MS=30000
SANGUINIUS_VOICE_INPUT_ROLLING_DAY_WINDOWS=50
SANGUINIUS_VOICE_INPUT_ROLLING_DAY_MICRO_USD=250000
SANGUINIUS_VOICE_INPUT_MONTHLY_MICRO_USD=5000000

# Voice output and narration. Limits may be lowered but never raised above the
# source-controlled ceilings. The fallback directory must contain an
# owner-approved, checksummed fallbacks-v1.json plus entrance/error/farewell PCM.
SANGUINIUS_TTS_PROVIDER=disabled
SANGUINIUS_TTS_MODEL=tts-1
SANGUINIUS_TTS_VOICE=onyx
SANGUINIUS_TTS_CACHE_DIRECTORY=/var/cache/sanguinius/tts
SANGUINIUS_FFMPEG_PATH=/usr/bin/ffmpeg
SANGUINIUS_FFPROBE_PATH=/usr/bin/ffprobe
SANGUINIUS_TTS_FALLBACK_DIRECTORY=/opt/sanguinius/current/assets/vox
SANGUINIUS_TTS_MAXIMUM_TEXT_SCALARS=350
SANGUINIUS_TTS_ROLLING_DAY_ATTEMPTS=100
SANGUINIUS_TTS_ROLLING_DAY_MICRO_USD=500000
SANGUINIUS_TTS_MONTHLY_MICRO_USD=10000000
SANGUINIUS_TTS_CACHE_MAXIMUM_MIB=64
SANGUINIUS_TTS_CACHE_MAXIMUM_DAYS=14
SANGUINIUS_TTS_MAXIMUM_DURATION_SECONDS=20
SANGUINIUS_TTS_CONNECT_TIMEOUT_MS=5000
SANGUINIUS_TTS_REQUEST_TIMEOUT_MS=30000
SANGUINIUS_FFPROBE_TIMEOUT_MS=5000
SANGUINIUS_FFMPEG_TIMEOUT_MS=10000

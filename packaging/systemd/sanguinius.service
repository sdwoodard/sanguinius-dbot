[Unit]
Description=Sanguinius Discord bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
User=sanguinius
Group=sanguinius
WorkingDirectory=/opt/sanguinius/current
EnvironmentFile=/etc/sanguinius/sanguinius.env
LoadCredential=discord-token:/etc/sanguinius/bot.token
LoadCredential=openai-key:/etc/sanguinius/openai.key
ExecStartPre=/usr/bin/env SANGUINIUS_TOKEN_FILE=%d/discord-token SANGUINIUS_OPENAI_API_KEY_FILE=%d/openai-key /opt/sanguinius/current/bin/sanguinius --check-config
ExecStartPre=/usr/bin/env SANGUINIUS_TOKEN_FILE=%d/discord-token SANGUINIUS_OPENAI_API_KEY_FILE=%d/openai-key /opt/sanguinius/current/bin/sanguinius db check
ExecStartPre=/usr/bin/env SANGUINIUS_TOKEN_FILE=%d/discord-token SANGUINIUS_OPENAI_API_KEY_FILE=%d/openai-key /opt/sanguinius/current/bin/sanguinius db integrity
ExecStartPre=/usr/bin/env SANGUINIUS_TOKEN_FILE=%d/discord-token SANGUINIUS_OPENAI_API_KEY_FILE=%d/openai-key /opt/sanguinius/current/bin/sanguinius db invariants check
ExecStart=/usr/bin/env SANGUINIUS_TOKEN_FILE=%d/discord-token SANGUINIUS_OPENAI_API_KEY_FILE=%d/openai-key /opt/sanguinius/current/bin/sanguinius
Restart=on-failure
RestartSec=5
WatchdogSec=60s
TimeoutStartSec=90
TimeoutStopSec=180
UMask=0077
StateDirectory=sanguinius
StateDirectoryMode=0750
CacheDirectory=sanguinius
CacheDirectoryMode=0700
LogsDirectory=sanguinius
LogsDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service @network-io
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitCORE=0
LimitMEMLOCK=16M
LimitNOFILE=2048
MemoryHigh=512M
MemoryMax=768M
TasksMax=64
CPUQuota=200%

[Install]
WantedBy=multi-user.target
